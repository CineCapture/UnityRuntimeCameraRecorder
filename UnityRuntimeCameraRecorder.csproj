<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>10</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Deterministic>false</Deterministic>
    <RootNamespace>UnityRuntimeCameraRecorder</RootNamespace>
    <AssemblyName>UnityRuntimeCameraRecorder</AssemblyName>
    <NativePlatform Condition="'$(NativePlatform)' == ''">x64</NativePlatform>
    <NativeConfiguration Condition="'$(NativeConfiguration)' == ''">$(Configuration)</NativeConfiguration>
    <NativeEncoderProject>$(MSBuildProjectDirectory)/Dependencies/Direct3DVideoEncoder/Direct3DVideoEncoder.vcxproj</NativeEncoderProject>
    <NativeEncoderOutput>$(MSBuildProjectDirectory)/Dependencies/Direct3DVideoEncoder/build/$(NativePlatform)/$(NativeConfiguration)/Direct3DVideoEncoder.dll</NativeEncoderOutput>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="Dependencies/FFmpegMediaWriter/FFmpegMediaWriter.csproj" />
    <None Include="$(NativeEncoderOutput)"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
      <Link>Direct3DVideoEncoder.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Reference Include="UnityEngine">
      <HintPath>$(UnityManagedPath)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityManagedPath)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AudioModule">
      <HintPath>$(UnityManagedPath)/UnityEngine.AudioModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(UnityManagedPath)/UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule">
      <HintPath>$(UnityManagedPath)/UnityEngine.ScreenCaptureModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Properties/AssemblyInfo.cs" />
    <Compile Include="Capture/*.cs" />
    <Compile Include="Pipeline/*.cs" />
  </ItemGroup>
  <Target Name="ValidateUnityManagedPath" BeforeTargets="ResolveReferences">
    <Error Condition="'$(UnityManagedPath)' == '' Or !Exists('$(UnityManagedPath)/UnityEngine.CoreModule.dll')"
           Text="Supply UnityManagedPath pointing to Unity's managed UnityEngine assembly directory." />
  </Target>
  <Target Name="BuildNativeEncoder"
          BeforeTargets="PrepareForBuild"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Error Condition="'$(NativeMSBuildPath)' == '' Or !Exists('$(NativeMSBuildPath)')"
           Text="Supply NativeMSBuildPath pointing to Visual Studio MSBuild.exe." />
    <Error Condition="!Exists('$(NativeEncoderProject)')"
           Text="Initialize the Direct3DVideoEncoder submodule." />
    <Exec Command="&quot;$(NativeMSBuildPath)&quot; &quot;$(NativeEncoderProject)&quot; /m /t:Build /p:Configuration=$(NativeConfiguration) /p:Platform=$(NativePlatform) /v:minimal" />
  </Target>
</Project>
